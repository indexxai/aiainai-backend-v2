# Copy to .env (never commit .env). Production values live in the host's secret store.

# ── Ports ────────────────────────────────────────────
PORT=4000            # HTTP API
WORKER_PORT=4001     # background worker (Inngest endpoint)

# Public URL of the web app (CORS + links in emails)
APP_URL=http://localhost:3000

# ── MongoDB Atlas (own project, separate from other indexx products) ──
# Local: the docker-compose Mongo. Atlas: mongodb+srv://USER:PASS@CLUSTER/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=aiainai

# Swagger UI at /api/swagger (default: on outside production)
# API_DOCS=false

# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# ── Background jobs: Inngest ─────────────────────────
INNGEST_DEV=1            # local only; remove in staging/production
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Sign-in (Better Auth) ────────────────────────────
# Required in production: 32+ random characters, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Google sign-in (optional; the button is hidden when unset).
# Authorised redirect URI in Google Cloud: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Resend) ───────────────────────────────────
# Required in production. Locally, without a key, sign-up codes are printed in the API log.
RESEND_API_KEY=
EMAIL_FROM=aiainai <hello@aiainai.ai>

# ── AI models ────────────────────────────────────────
# Set in the host's secret store, never in chat or git. After adding a key, turn models on with
#   pnpm models:configure gpt=<openai model id> claude-sonnet=<anthropic model id> ...
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# One key for every model maker (OpenAI, Anthropic, Gemini, DeepSeek, Kimi, Qwen). Models get an
# OpenRouter id with `pnpm models:configure <key>.openrouter=<id>`; they then go through OpenRouter.
OPENROUTER_API_KEY=
# App connections: Gmail, Google Calendar, Google Drive and Slack through Composio (composio.dev).
# 1. Sign up, open a project and copy its API key into COMPOSIO_API_KEY.
# 2. Under Auth Configs, create one per app (toolkits: Gmail, Google Calendar, Google Drive, Slack)
#    with Composio-managed sign-in, and paste each auth config id (ac_…) below.
# 3. Add <APP_URL>/connections to the allowed redirect/callback URLs if the dashboard asks.
# An app whose auth config is empty shows as "Coming soon". Without a key a stand-in is used locally.
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_GOOGLE_CALENDAR=
COMPOSIO_AUTH_CONFIG_GOOGLE_DRIVE=
COMPOSIO_AUTH_CONFIG_SLACK=
# Business space (Captain Jack): off until it launches. Off = every request is Personal and
# Business set-up is refused; the app shows a "coming soon" page instead.
BUSINESS_SPACE=off
# Sign-up email codes: off until an email service is set up. Off = new accounts are signed in
# straight after sign-up, with no code step. Set to on once email sending works.
EMAIL_VERIFICATION=off
# Jack's browser (v2): Browserbase key and project id. Without them a sample browser is used locally.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Payments (Stripe Checkout, one-time): secret key (sk_test_… / sk_live_…) and the webhook signing
# secret (whsec_…) of the endpoint <API URL>/api/billing/stripe/webhook. Without a key a sample
# checkout is used locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# AI Image: Upscale and Remove background (Pro). Leave empty to hide those two tools.
STABILITY_API_KEY=
# Stand-in model with sample answers (default: on locally when no key is set; refused in production)
# AI_DEMO=true

# ── File storage (generated images; uploads later) ───
# gridfs = inside MongoDB (no extra service). An S3-compatible driver can be added when chosen.
STORAGE_DRIVER=gridfs

# ── Added in later MVP days (not used yet) ──────────
# FAL_KEY= / TAVILY_API_KEY=                                               # images, research
# REDIS_URL= / S3_* (object storage)
