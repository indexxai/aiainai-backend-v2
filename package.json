{
  "name": "aiainai-backend",
  "version": "0.0.1",
  "description": "aiainai (AI Station) backend: NestJS API and background worker",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write .",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts --passWithNoTests",
    "start:worker": "node dist/worker.js",
    "start:worker:dev": "nest start --watch --entryFile worker",
    "openapi": "nest build && node dist/openapi.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check .",
    "seed": "nest build && node dist/seed.js",
    "test:int": "vitest run --config ./vitest.config.int.ts",
    "models:configure": "nest build && node dist/configure-models.js",
    "dev:memory": "nest build && node dist/testing/memory-server.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.71",
    "@ai-sdk/openai": "4.0.83",
    "@ai-sdk/provider": "4.0.21",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "12.0.2",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.127",
    "better-auth": "1.7.7",
    "docx": "^9.8.1",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "helmet": "^8.3.0",
    "inngest": "4.21.1",
    "mammoth": "1.11.0",
    "marked": "^18.1.0",
    "mongodb": "^7.6.0",
    "mongoose": "9.10.4",
    "nestjs-pino": "5.3.1",
    "pdfmake": "^0.3.11",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "playwright-core": "1.56.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.35.5",
    "stripe": "^18.5.0",
    "unpdf": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfmake": "^0.3.3",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "mingo": "^7.2.4",
    "oxlint": "^1.58.0",
    "pino-pretty": "13.2.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@swc/core",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
